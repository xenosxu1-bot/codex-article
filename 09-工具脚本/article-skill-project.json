{
  "schema_version": "1.0",
  "project": "codex-article",
  "canonical_skill": {
    "repository": "xenosxu1-bot/article-Skill",
    "branch": "main"
  },
  "runtime_resolution": [
    "--skill-root",
    "ARTICLE_SKILL_ROOT",
    "../article-Skill"
  ],
  "paths": {
    "metadata_directory": "07-资料与流程/文章元数据",
    "asset_registry": "07-资料与流程/文章资产登记表.md",
    "cover_directory": "08-素材库/图片/文章封面",
    "inline_image_directory": "08-素材库/图片/正文插图"
  },
  "validation": {
    "manifest_required_tiers": [
      "standard",
      "deep"
    ],
    "min_inline_images": {
      "quick": 0,
      "standard": 1,
      "deep": 2
    },
    "cover_ratio": 2.35,
    "cover_ratio_tolerance": 0.05,
    "min_cover_width": 1200
  },
  "skill_integrity": {
    "lock_file": "09-工具脚本/article-skill.lock.json",
    "required_git_worktree": true,
    "require_clean_worktree": true,
    "allow_personal_installation_fallback": false
  }
}
