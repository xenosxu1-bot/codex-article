{
  "schema_version": "1.0",
  "project": "codex-article",
  "canonical_skill": {
    "repository": "xenosxu1-bot/article-Skill",
    "branch": "main"
  },
  "runtime_resolution": [
    "--skill-root",
    "ARTICLE_SKILL_ROOT",
    "../article-Skill"
  ],
  "paths": {
    "metadata_directory": "07-资料与流程/03-资产与核验/文章元数据",
    "asset_registry": "07-资料与流程/03-资产与核验/文章资产登记表.md",
    "cover_directory": "assets/cover",
    "inline_image_directory": "assets/figures",
    "historical_asset_archive": "07-资料与流程/03-资产与核验/历史素材归档"
  },
  "validation": {
    "manifest_required_tiers": [
      "standard",
      "deep"
    ],
    "min_inline_images": {
      "quick": 0,
      "standard": 1,
      "deep": 2
    },
    "cover_ratio": 2.35,
    "cover_ratio_tolerance": 0.05,
    "min_cover_width": 1200
  },
  "skill_integrity": {
    "lock_file": "09-工具脚本/03-技能接入/article-skill.lock.json",
    "required_git_worktree": true,
    "require_clean_worktree": true,
    "allow_personal_installation_fallback": false
  },
  "repository_sync": {
    "enabled": true,
    "capability": "github-update-push",
    "intent_schema": "repository-sync-intent.v1",
    "target": {
      "id": "codex-article",
      "branch": "main"
    },
    "trigger": {
      "authorization_field": "allow_repository_sync",
      "required_intent_status": "ready",
      "required_execution_profile": "production"
    },
    "required_checks": [
      "article_unified_check",
      "one_click_publish_check",
      "project_deep_verify",
      "git_diff_check",
      "staged_secret_scan"
    ],
    "safety": {
      "block_on_unowned_changes": true,
      "block_on_preexisting_staged_changes": true,
      "block_when_remote_not_equal": true,
      "allow_automatic_merge": false,
      "allow_force_push": false,
      "allowed_owned_path_prefixes": [
        "README.md",
        "00-知识库导航",
        "01-工具教程",
        "02-效率方法",
        "03-AI与创作",
        "04-编程与开发",
        "05-职场与成长",
        "06-案例与复盘",
        "07-资料与流程"
      ]
    },
    "executor": {
      "script": "scripts/sync-generated-article.ps1",
      "receipt_policy": "Return JSON to stdout. Optional receipts belong only in .tmp and are not publishable assets."
    }
  }
}
